  "source_confidence_matrix": {
    "description": "命中不同类型数据源时的置信度加权规则（叠加，封顶 100）",
    "rules": [
      { "type": "government_customs",    "boost": 35, "example": "AliceWeb, SUNAT" },
      { "type": "trade_show",            "boost": 28, "example": "SAITEX, APAS" },
      { "type": "tax_verified",          "boost": 40, "example": "命中 CNPJ/RUC 等活跃纳税记录" },
      { "type": "industrial_b2b_directory", "boost": 22, "example": "ThomasNet" },
      { "type": "b2b_directory",         "boost": 18, "example": "B2B Brazil, Wholesale Central" },
      { "type": "local_search_engine",   "boost": 15, "example": "Seznam.cz, Rambler.ru" },
      { "type": "whatsapp_explicit",     "boost": 10, "example": "Empresascope decision-maker" },
      { "type": "bol_cross_match",       "boost": 30, "example": "黄页公司名在 BOL/海关数据库有记录" }
