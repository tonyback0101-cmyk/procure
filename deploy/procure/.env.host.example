# 新加坡台式机 — procure Phase 1 环境模板
# 用法:
#   cp deploy/procure/.env.host.example /opt/zhimao/procure/.env
#   chmod 600 /opt/zhimao/procure/.env
#   # 从 Render Dashboard 填入 sync:false 的密钥
#
# 本机仍写云端 Supabase（不迁库）。并发相对 Render 已下调，适配 16GB。
# Vast 共存: STEP3_PAGE_CONCURRENCY 可再降到 4；勿设置 CUDA_VISIBLE_DEVICES。

# ─── Required（从 Render 导出）──────────────────────────────────
GEMINI_KEY=
GOOGLE_MAPS_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-4.1-mini

SERPER_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DIRECT_L1_CHUNK=80

# P1-D 原子领单（与 Render discovery worker 相同）
DATABASE_URL=

# ─── BrightData（可先保持与 Render 一致）────────────────────────
USE_PROXY=true
BRD_USER=
BRD_PASS=
BRD_PROXY=http://brd.superproxy.io:33335
USE_BRD_SB=false
BRD_SB_WSS=

# ─── CRM B2（可选）──────────────────────────────────────────────
ZHIMAO_APP_URL=
CRM_WATCH_EMIT_SECRET=
DISCOVERY_COMPLETION_NOTIFY=supabase
CRM_WATCH_EMIT_ON_FAILURE=false

# ─── Vision（可选）──────────────────────────────────────────────
SCREENSHOTONE_API_KEY=
BROWSERLESS_API_TOKEN=

# ─── 运行模式（对齐 render.yaml，本机并发下调）──────────────────
SKIP_SQLITE=true
ICP_MATCH_THRESHOLD=soft

PLAYWRIGHT_TIMEOUT=12000
# 本机内存充足用 12（对齐 Render）
STEP3_PAGE_CONCURRENCY=12

# Step3+代理常 >10min；不调高会 step timeout。超时后会降级用已有数据落库，不再整单空失败。
DISCOVERY_STEP_TIMEOUT_MS=1500000
DISCOVERY_PIPELINE_MAX_MS=1800000
# SIGTERM 后给 step3 刷 checkpoint + step4/5 的宽限（默认 90s 偏紧）
DISCOVERY_PIPELINE_KILL_GRACE_MS=180000

STEP1_TIERED=1
STEP1_ENOUGH_HITS=80
STEP3_DEFER_CONTACT=1
ENRICH_IDLE_IN_DISCOVERY_WORKER=0

# Step2 后只对最好的 N 条跑 Step3；溢出轻量入库、低分排后展示（<=0 关闭）
ENRICH_TOP_N=30
# Top-N 最低预排序分；过低噪声不进贵 Step3（默认 18）
ENRICH_MIN_TOP_SCORE=18
# Top-N 内品类相关席位保底（默认 min(8,TOP_N)；0=关闭）
ENRICH_RELEVANCE_FLOOR=8

# L3：5 降截断（保准）；L3_WALL_MS=0 关闭跳过 batch（默认保准）
BOM_BATCH_SIZE=5
L3_CONCURRENCY=4
L3_MAX_RETRIES=1
L3_WALL_MS=0
STEP3_CHECKPOINT_EVERY=5

INTAKE_FAST_PATH=1
INTAKE_BATCH_SIZE=15
INTAKE_CONCURRENCY=6

ENRICH_WORKER_DEDICATED=1
ENRICH_POLL_MS=4000
ENRICH_QUEUE_BATCH_SIZE=20
ENRICH_QUEUE_MAX_PER_JOB=150
ENRICH_QUEUE_MAX_RETRIES=5
ENRICH_PROMOTE_SCORE=70

STALE_CLAIM_SECONDS=900
CANCEL_POLL_MS=3000

TAX_VERIFY_ENABLED=false
TAX_VERIFY_CONCURRENCY=3
TAX_VERIFY_TIMEOUT_MS=5000

# 本机实例标识前缀（pm2 会再拼 NODE_APP_INSTANCE）
RENDER_INSTANCE_ID=sg-procure
